# Public URL of the site (used for Paystack return links, sitemap, metadata)
NEXT_PUBLIC_SITE_URL=https://www.example.org

# --- Admin ---
# Generate a unique secret for each environment:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_64_CHARACTER_SECRET
# JSON array. role is "editor" or "super"
ADMIN_USERS='[]'

# --- Supabase (persistent content and gallery uploads on Vercel) ---
# Use the Supabase session pooler connection string for DATABASE_URL.
DATABASE_URL=
SUPABASE_URL=https://your-project.supabase.co
# Server-only secret key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (giving) ---
# Off until DBIF leadership approves online giving
GIVING_ENABLED=false
# Use sk_test_... until DBIF's live Paystack account is approved
PAYSTACK_SECRET_KEY=
# Also set the webhook URL in the Paystack dashboard to: <site>/api/paystack/webhook

# --- Email (optional; without these, emails are logged and skipped) ---
RESEND_API_KEY=
MAIL_FROM="DBIF <no-reply@your-domain>"
# Where contact messages and gift alerts are sent
NOTIFY_EMAIL=

# Optional local JSON data directory used only when DATABASE_URL is not set.
# DATA_DIR=
