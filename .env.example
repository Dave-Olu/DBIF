# Public URL of the site (used for Paystack return links, sitemap, metadata)
NEXT_PUBLIC_SITE_URL=https://www.example.org

# --- Admin ---
# At least 32 random characters. Generate: openssl rand -hex 32
SESSION_SECRET=
# JSON array. role is "editor" or "super"
ADMIN_USERS=[{"email":"admin@example.org","password":"change-me-now","role":"super"}]

# --- Paystack (giving) ---
# Off until DBIF leadership approves online giving
GIVING_ENABLED=false
# Use sk_test_... until DBIF's live Paystack account is approved
PAYSTACK_SECRET_KEY=
# Also set the webhook URL in the Paystack dashboard to: <site>/api/paystack/webhook

# --- Email (optional; without these, emails are logged and skipped) ---
RESEND_API_KEY=
MAIL_FROM="DBIF <no-reply@your-domain>"
# Where contact messages and gift alerts are sent
NOTIFY_EMAIL=

# Where JSON data files live (default: ./.data). Must be persistent, writable disk.
# DATA_DIR=
